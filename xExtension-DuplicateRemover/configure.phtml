<?php
$dedupe_mode = $this->getUserConfigurationValue('mode', 'title');
$enable_log = $this->getUserConfigurationValue('enable_log', false);
if (isset(FreshRSS_Context::$user_conf->DuplicateRemover_mode) && $dedupe_mode === 'title') {
    $dedupe_mode = FreshRSS_Context::$user_conf->DuplicateRemover_mode;
}
if (isset(FreshRSS_Context::$user_conf->DuplicateRemover_log) && !$enable_log) {
    $enable_log = FreshRSS_Context::$user_conf->DuplicateRemover_log === '1';
}
?>

<form action="<?php echo _url('extension', 'configure', 'e', urlencode($this->getName())); ?>" method="post">
    <input type="hidden" name="_csrf" value="<?php echo FreshRSS_Auth::csrfToken(); ?>" />
    
    <div class="form-group">
        <label class="group-name" for="dedupe_mode">Duplicate detection:</label>
        <div class="group-controls">
            <select name="dedupe_mode" id="dedupe_mode">
                <option value="title" <?php echo ($dedupe_mode === 'title') ? 'selected' : ''; ?>>
                    Title only (recommended)
                </option>
                <option value="title_link" <?php echo ($dedupe_mode === 'title_link') ? 'selected' : ''; ?>>
                    Title and link
                </option>
            </select>
            <p class="help-block">
                • Title only: matching titles are treated as duplicates, even if links differ<br/>
                • Title and link: both must match before an article is treated as a duplicate
            </p>
        </div>
    </div>
    
    <div class="form-group">
        <label class="group-name">Logging:</label>
        <div class="group-controls">
            <label>
                <input type="checkbox" name="enable_log" value="1" <?php 
                if ($enable_log) {
                    echo ' checked="checked"';
                }
                ?> />
                Enable logging
            </label>
            <p class="help-block">
                Records duplicate actions in the server log for troubleshooting
            </p>
        </div>
    </div>
    
    <div class="form-group">
        <label class="group-name">What it does:</label>
        <div class="group-controls">
            <ul style="margin: 10px 0; padding-left: 20px;">
                <li>Detects duplicate articles across different feeds</li>
                <li>Blocks new duplicate articles from being inserted</li>
                <li>Marks existing newer cross-feed duplicate copies as read</li>
                <li>Keeps the earliest copy of each duplicate group unread</li>
                <li>Does not delete existing articles; it makes duplicates read</li>
                <li>Runs automatically during feed refreshes / user maintenance</li>
            </ul>
        </div>
    </div>
    
    <div class="form-group form-actions">
        <div class="group-controls">
            <button type="submit" class="btn btn-important"><?php echo _t('gen.action.submit'); ?></button>
            <button type="reset" class="btn"><?php echo _t('gen.action.cancel'); ?></button>
        </div>
    </div>
</form>
