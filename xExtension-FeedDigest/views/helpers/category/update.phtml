<?php
/**
 * Category settings for Feed Digest.
 */
if (!isset($this->category) || $this->category === null) {
	return;
}

$category = $this->category;
$extension = Minz_ExtensionManager::findExtension('Feed Digest');
$categorySettings = $extension === null ? [] : $extension->getCategorySettings();
$settings = $categorySettings[(string)$category->id()] ?? [];

$enabled = !empty($settings['enabled']);
$hideFromMainStream = !empty($settings['hide_from_main_stream']);
$markRead = !isset($settings['mark_read']) || (bool)$settings['mark_read'];
$batchSize = (int)($settings['batch_size'] ?? 0);
if ($batchSize > 0 && $batchSize < 2) {
	$batchSize = 2;
}
$scheduleMode = (string)($settings['schedule_modes'] ?? 'auto');
$scheduleModes = array_filter(explode(',', $scheduleMode));
// Legacy multi-mode values are normalized to the first selected mode for the dropdown.
$scheduleMode = $scheduleModes[array_key_first($scheduleModes)] ?? 'auto';
$scheduleModes = [$scheduleMode];
$scheduleTimes = (string)($settings['schedule_times'] ?? '06:00,11:00,17:00,21:00');
$scheduleInterval = (int)($settings['schedule_interval'] ?? 60);
$language = (string)($settings['language'] ?? '');
$secondaryLanguage = (string)($settings['secondary_language'] ?? '');
$titlesOnly = !array_key_exists('titles_only', $settings) || !empty($settings['titles_only']);
$overviewBullets = (int)($settings['overview_bullets'] ?? 3);
if ($overviewBullets < 0) {
	$overviewBullets = 3;
}

ob_start();
$coreView = APP_PATH . '/views/helpers/category/update.phtml';
if (file_exists($coreView)) {
	include $coreView;
}
$coreHtml = ob_get_clean();

$fields = '
<hr />
<fieldset style="margin-top: 2em;">
	<legend>' . _t('ext.feed_digest.category_setting_title', 'Feed Digest Summary') . '</legend>

	<div class="form-group">
		<label class="group-name" for="feed_digest_category_enabled">' . _t('ext.feed_digest.category_setting_label', 'Create a summary feed for this category') . '</label>
		<div class="group-controls">
			<select name="feed_digest_category_enabled" id="feed_digest_category_enabled" class="w50">
				<option value=""' . (!$enabled ? ' selected="selected"' : '') . '>' . _t('gen.short.no') . '</option>
				<option value="1"' . ($enabled ? ' selected="selected"' : '') . '>' . _t('gen.short.yes') . '</option>
			</select>
			<p class="help">' . _i('help') . ' ' . _t('ext.feed_digest.category_setting_help', 'Create a visible native feed containing summaries from all feeds in this category. The summary feed is placed in the shared "Digests" category so external readers can group all digests together.') . '</p>
		</div>
	</div>

	<div class="form-group">
		<label class="group-name" for="feed_digest_category_hide_from_main_stream">' . _t('ext.feed_digest.category_hide_from_main_stream_label', 'Hide source feeds from Main stream') . '</label>
		<div class="group-controls">
			<select name="feed_digest_category_hide_from_main_stream" id="feed_digest_category_hide_from_main_stream" class="w50">
				<option value=""' . (!$hideFromMainStream ? ' selected="selected"' : '') . '>' . _t('gen.short.no') . '</option>
				<option value="1"' . ($hideFromMainStream ? ' selected="selected"' : '') . '>' . _t('gen.short.yes') . '</option>
			</select>
			<p class="help">' . _i('help') . ' ' . _t('ext.feed_digest.category_hide_from_main_stream_help', 'Keep this category\'s feeds visible only inside the category (and their own feed page) instead of also showing them in Main stream / All.') . '</p>
		</div>
	</div>

	<div class="form-group">
		<label class="group-name" for="feed_digest_category_mark_read">' . _t('ext.feed_digest.mark_read_label', 'Mark source articles as read') . '</label>
		<div class="group-controls">
			<select name="feed_digest_category_mark_read" id="feed_digest_category_mark_read" class="w50">
				<option value="1"' . ($markRead ? ' selected="selected"' : '') . '>' . _t('gen.short.yes') . '</option>
				<option value=""' . (!$markRead ? ' selected="selected"' : '') . '>' . _t('gen.short.no') . '</option>
			</select>
			<p class="help">' . _i('help') . ' ' . _t('ext.feed_digest.mark_read_help', 'Only successfully processed source articles are marked read. Failed and skipped articles remain unread.') . '</p>
		</div>
	</div>

	<div class="form-group">
		<label class="group-name" for="feed_digest_category_schedule_modes">' . _t('ext.feed_digest.schedule_modes_label', 'Schedule mode') . '</label>
		<div class="group-controls">
			<select name="feed_digest_category_schedule_modes[]" id="feed_digest_category_schedule_modes" class="w50" onchange="feedDigestToggleCategoryScheduleFields()">
				<option value="auto"' . ($scheduleMode === 'auto' ? ' selected="selected"' : '') . '>' . _t('ext.feed_digest.schedule_auto', 'Automatic') . '</option>
				<option value="daily"' . ($scheduleMode === 'daily' ? ' selected="selected"' : '') . '>' . _t('ext.feed_digest.schedule_daily', 'Daily times') . '</option>
				<option value="interval"' . ($scheduleMode === 'interval' ? ' selected="selected"' : '') . '>' . _t('ext.feed_digest.schedule_interval', 'Interval') . '</option>
			</select>
			<p class="help">' . _i('help') . ' ' . _t('ext.feed_digest.schedule_modes_help', 'Choose one schedule mode. Automatic runs on each maintenance cycle; Daily runs at the specified local times.') . '</p>
		</div>
	</div>

	<div class="form-group feed-digest-category-schedule-times" data-mode="daily">
		<label class="group-name" for="feed_digest_category_schedule_times">' . _t('ext.feed_digest.schedule_times_label', 'Daily times') . '</label>
		<div class="group-controls">
			<input type="text" name="feed_digest_category_schedule_times" id="feed_digest_category_schedule_times" value="' . htmlspecialchars($scheduleTimes, ENT_QUOTES, 'UTF-8') . '" class="w50" placeholder="06:00, 16:00" />
			<p class="help">' . _i('help') . ' ' . _t('ext.feed_digest.schedule_times_help', 'Comma-separated local times in HH:MM format. Uses the FreshRSS/PHP timezone.') . '</p>
		</div>
	</div>

	<div class="form-group feed-digest-category-schedule-interval" data-mode="interval">
		<label class="group-name" for="feed_digest_category_schedule_interval">' . _t('ext.feed_digest.schedule_interval_label', 'Interval minutes') . '</label>
		<div class="group-controls">
			<input type="number" name="feed_digest_category_schedule_interval" id="feed_digest_category_schedule_interval" value="' . $scheduleInterval . '" min="1" max="10080" class="w50" />
			<p class="help">' . _i('help') . ' ' . _t('ext.feed_digest.schedule_interval_help', 'Run after this many minutes since the last successful scheduled run (default 60 = 1 hour).') . '</p>
		</div>
	</div>

	<div class="form-group">
		<label class="group-name" for="feed_digest_category_batch_size">' . _t('ext.feed_digest.batch_size_label', 'Articles per summary batch') . '</label>
		<div class="group-controls">
			<input type="number" name="feed_digest_category_batch_size" id="feed_digest_category_batch_size" value="' . ($batchSize === 0 ? '' : $batchSize) . '" min="0" step="1" class="w50" placeholder="0 = unlimited" />
			<p class="help">' . _i('help') . ' ' . _t('ext.feed_digest.category_batch_size_help', 'Set to 0 for no limit (summarize everything in one run).') . '</p>
		</div>
	</div>

	<div class="form-group">
		<label class="group-name" for="feed_digest_category_titles_only">' . _t('ext.feed_digest.titles_only_label', 'Titles only') . '</label>
		<div class="group-controls">
			<select name="feed_digest_category_titles_only" id="feed_digest_category_titles_only" class="w50">
				<option value=""' . (!$titlesOnly ? ' selected="selected"' : '') . '>' . _t('gen.short.no') . '</option>
				<option value="1"' . ($titlesOnly ? ' selected="selected"' : '') . '>' . _t('gen.short.yes') . '</option>
			</select>
			<p class="help">' . _i('help') . ' ' . _t('ext.feed_digest.titles_only_help', 'Instead of per-article summaries, create one compact digest listing original titles (with source-feed labels) and links to the original articles, without translating titles.') . '</p>
		</div>
	</div>

	<div class="form-group">
		<label class="group-name" for="feed_digest_category_overview_bullets">' . _t('ext.feed_digest.overview_bullets_label', 'Top-level theme bullets') . '</label>
		<div class="group-controls">
			<input type="number" name="feed_digest_category_overview_bullets" id="feed_digest_category_overview_bullets"
			       value="' . $overviewBullets . '"
			       min="0" step="1"
			       class="w50" />
			<p class="help">' . _i('help') . ' ' . _t('ext.feed_digest.overview_bullets_help', 'How many key-theme bullet points to list above the digest. 0 disables bullets and keeps only the 2-sentence overview.') . '</p>
		</div>
	</div>

	<div class="form-group">
		<label class="group-name" for="feed_digest_category_language">' . _t('ext.feed_digest.language_label', 'Summary language') . '</label>
		<div class="group-controls">
			<select name="feed_digest_category_language" id="feed_digest_category_language" class="w50">
				<option value=""' . ($language === '' ? ' selected="selected"' : '') . '>' . _t('ext.feed_digest.language_global_default', 'Use global default') . '</option>
				' . implode('', array_map(static function (string $code) use ($language): string {
					return '<option value="' . htmlspecialchars($code, ENT_QUOTES, 'UTF-8') . '"'
						. ($language === $code ? ' selected="selected"' : '')
						. '>' . htmlspecialchars(FeedDigestExtension::SUPPORTED_LANGUAGES[$code], ENT_QUOTES, 'UTF-8') . '</option>';
				}, array_keys(FeedDigestExtension::SUPPORTED_LANGUAGES))) . '
			</select>
			<p class="help">' . _i('help') . ' ' . _t('ext.feed_digest.language_help', 'Optional language override for this category. Leave blank to use the global Destination Language.') . '</p>
		</div>
	</div>

	<div class="form-group">
		<label class="group-name" for="feed_digest_category_secondary_language">' . _t('ext.feed_digest.secondary_language', 'Secondary language') . '</label>
		<div class="group-controls">
			<select name="feed_digest_category_secondary_language" id="feed_digest_category_secondary_language" class="w50">
				<option value=""' . ($secondaryLanguage === '' ? ' selected="selected"' : '') . '>' . _t('ext.feed_digest.secondary_language_off', 'Disabled') . '</option>
				' . implode('', array_map(static function (string $code) use ($secondaryLanguage): string {
					return '<option value="' . htmlspecialchars($code, ENT_QUOTES, 'UTF-8') . '"'
						. ($secondaryLanguage === $code ? ' selected="selected"' : '')
						. '>' . htmlspecialchars(FeedDigestExtension::SUPPORTED_LANGUAGES[$code], ENT_QUOTES, 'UTF-8') . '</option>';
				}, array_keys(FeedDigestExtension::SUPPORTED_LANGUAGES))) . '
			</select>
			<p class="help">' . _i('help') . ' ' . _t('ext.feed_digest.secondary_language_help', 'Optional second language shown as a separate muted paragraph below the primary language for the TL;DR and per-feed themes. Leave Disabled for single-language digests.') . '</p>
		</div>
	</div>
</fieldset>

<script>
function feedDigestToggleCategoryScheduleFields() {
	var select = document.getElementById("feed_digest_category_schedule_modes");
	if (!select) { return; }
	var mode = select.value;
	document.querySelectorAll(".feed-digest-category-schedule-times").forEach(function(el) {
		el.style.display = mode === "daily" ? "" : "none";
	});
	document.querySelectorAll(".feed-digest-category-schedule-interval").forEach(function(el) {
		el.style.display = mode === "interval" ? "" : "none";
	});
}
document.addEventListener("DOMContentLoaded", feedDigestToggleCategoryScheduleFields);
</script>
';

$modifiedHtml = preg_replace('/(<div class="form-group form-actions">)/', $fields . "\n" . '$1', $coreHtml, 1);
echo $modifiedHtml;
?>
