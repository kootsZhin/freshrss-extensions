<?php
/**
 * Category settings for Feed Digest.
 */
if (!isset($this->category) || $this->category === null) {
	return;
}

$category = $this->category;
$extension = Minz_ExtensionManager::findExtension('Feed Digest');
$settings = $extension === null ? [] : ($extension->getCategorySettings()[(string)$category->id()] ?? []);
$enabled = !empty($settings['enabled']);
$markRead = !isset($settings['mark_read']) || (bool)$settings['mark_read'];
$batchSize = (int)($settings['batch_size'] ?? 10);
$scheduleModes = array_filter(explode(',', (string)($settings['schedule_modes'] ?? 'auto')));
$scheduleTimes = (string)($settings['schedule_times'] ?? '');
$scheduleInterval = (int)($settings['schedule_interval'] ?? 24);

ob_start();
$coreView = APP_PATH . '/views/helpers/category/update.phtml';
if (file_exists($coreView)) {
	include $coreView;
}
$coreHtml = ob_get_clean();

$fields = '
<hr />
<fieldset style="margin-top: 2em;">
	<legend>' . _t('ext.feed_digest.category_setting_title', 'Feed Digest Summary') . '</legend>

	<div class="form-group">
		<label class="group-name" for="feed_digest_category_enabled">' . _t('ext.feed_digest.category_setting_label', 'Create a summary feed for this category') . '</label>
		<div class="group-controls">
			<select name="feed_digest_category_enabled" id="feed_digest_category_enabled" class="w50">
				<option value=""' . (!$enabled ? ' selected="selected"' : '') . '>' . _t('gen.short.no') . '</option>
				<option value="1"' . ($enabled ? ' selected="selected"' : '') . '>' . _t('gen.short.yes') . '</option>
			</select>
			<p class="help">' . _i('help') . ' ' . _t('ext.feed_digest.category_setting_help', 'Create a Feed Summary feed containing summaries from all feeds in this category.') . '</p>
		</div>
	</div>

	<div class="form-group">
		<label class="group-name" for="feed_digest_category_mark_read">' . _t('ext.feed_digest.mark_read_label', 'Mark source articles as read') . '</label>
		<div class="group-controls">
			<select name="feed_digest_category_mark_read" id="feed_digest_category_mark_read" class="w50">
				<option value="1"' . ($markRead ? ' selected="selected"' : '') . '>' . _t('gen.short.yes') . '</option>
				<option value=""' . (!$markRead ? ' selected="selected"' : '') . '>' . _t('gen.short.no') . '</option>
			</select>
			<p class="help">' . _i('help') . ' ' . _t('ext.feed_digest.mark_read_help', 'Only successfully processed source articles are marked read.') . '</p>
		</div>
	</div>

	<div class="form-group">
		<label class="group-name" for="feed_digest_category_schedule_modes">' . _t('ext.feed_digest.schedule_modes_label', 'Schedule modes') . '</label>
		<div class="group-controls">
			<select name="feed_digest_category_schedule_modes[]" id="feed_digest_category_schedule_modes" class="w50" multiple="multiple" size="3">
				<option value="auto"' . (in_array('auto', $scheduleModes, true) ? ' selected="selected"' : '') . '>' . _t('ext.feed_digest.schedule_auto', 'Automatic') . '</option>
				<option value="daily"' . (in_array('daily', $scheduleModes, true) ? ' selected="selected"' : '') . '>' . _t('ext.feed_digest.schedule_daily', 'Daily times') . '</option>
				<option value="interval"' . (in_array('interval', $scheduleModes, true) ? ' selected="selected"' : '') . '>' . _t('ext.feed_digest.schedule_interval', 'Interval') . '</option>
			</select>
		</div>
	</div>

	<div class="form-group">
		<label class="group-name" for="feed_digest_category_schedule_times">' . _t('ext.feed_digest.schedule_times_label', 'Daily times') . '</label>
		<div class="group-controls">
			<input type="text" name="feed_digest_category_schedule_times" id="feed_digest_category_schedule_times" value="' . htmlspecialchars($scheduleTimes, ENT_QUOTES, 'UTF-8') . '" class="w50" placeholder="06:00, 16:00" />
		</div>
	</div>

	<div class="form-group">
		<label class="group-name" for="feed_digest_category_schedule_interval">' . _t('ext.feed_digest.schedule_interval_label', 'Interval hours') . '</label>
		<div class="group-controls">
			<input type="number" name="feed_digest_category_schedule_interval" id="feed_digest_category_schedule_interval" value="' . $scheduleInterval . '" min="1" max="168" class="w50" />
		</div>
	</div>

	<div class="form-group">
		<label class="group-name" for="feed_digest_category_batch_size">' . _t('ext.feed_digest.batch_size_label', 'Articles per summary batch') . '</label>
		<div class="group-controls">
			<input type="number" name="feed_digest_category_batch_size" id="feed_digest_category_batch_size" value="' . $batchSize . '" min="1" max="50" class="w50" />
		</div>
	</div>
</fieldset>
';

$modifiedHtml = preg_replace('/(<div class="form-group form-actions">)/', $fields . "\n" . '$1', $coreHtml, 1);
echo $modifiedHtml;
?>
