<form action="<?php echo _url('extension', 'configure', 'e', urlencode($this->getName())); ?>" method="post">
    <input type="hidden" name="_csrf" value="<?php echo FreshRSS_Auth::csrfToken(); ?>" />

    <!-- Google Translate 语言方向设置 -->
    <div class="form-group">
        <label class="group-name" for="source-lang">翻译源语言:</label>
        <div class="group-controls">
            <?php
            $sourceLang = FreshRSS_Context::$user_conf->SourceLang ?? TranslateTitlesExtension::DEFAULT_SOURCE_LANG;
            $targetLang = FreshRSS_Context::$user_conf->TargetLang ?? TranslateTitlesExtension::DEFAULT_TARGET_LANG;
            ?>
            <select id="source-lang" name="SourceLang" required>
                <?php foreach (TranslateTitlesExtension::SUPPORTED_LANGUAGES as $code => $label): ?>
                    <option value="<?php echo htmlspecialchars($code, ENT_QUOTES, 'UTF-8'); ?>" <?php echo ($sourceLang === $code ? 'selected' : ''); ?>>
                        <?php echo htmlspecialchars($label, ENT_QUOTES, 'UTF-8'); ?>
                    </option>
                <?php endforeach; ?>
            </select>
        </div>
    </div>

    <div class="form-group">
        <label class="group-name" for="target-lang">翻译目标语言:</label>
        <div class="group-controls">
            <select id="target-lang" name="TargetLang" required>
                <?php foreach (TranslateTitlesExtension::SUPPORTED_LANGUAGES as $code => $label): ?>
                    <option value="<?php echo htmlspecialchars($code, ENT_QUOTES, 'UTF-8'); ?>" <?php echo ($targetLang === $code ? 'selected' : ''); ?>>
                        <?php echo htmlspecialchars($label, ENT_QUOTES, 'UTF-8'); ?>
                    </option>
                <?php endforeach; ?>
            </select>
        </div>
    </div>

    <!-- 订阅源翻译设置 -->
    <div class="form-group">
        <label class="group-name">订阅源翻译设置:</label>
        <div class="group-controls">
            <?php 
            $feeds = FreshRSS_Factory::createFeedDao()->listFeeds();
            if (empty($feeds)): ?>
                <span>暂无订阅源，请添加后重试</span>
            <?php else: ?>
                <?php foreach ($feeds as $id => $feed): ?>
                <li class="form-group">
                    <span class="feed-name"><?php echo $feed->name(); ?></span>
                    <input type="checkbox" id="feed-<?php echo $id; ?>" name="TranslateTitles[<?php echo $id; ?>]" value="1" <?php if (isset(FreshRSS_Context::$user_conf->TranslateTitles[$id]) && FreshRSS_Context::$user_conf->TranslateTitles[$id] == '1') echo ' checked="checked"'; ?>>
                </li>
                <?php endforeach; ?>
            <?php endif; ?>
        </div>
    </div>

    <!-- 提交与取消按钮 -->
    <div class="form-group form-actions">
        <div class="group-controls">
            <button type="submit" class="btn btn-important"><?php echo _t('gen.action.submit'); ?></button>
            <button type="reset" class="btn"><?php echo _t('gen.action.cancel'); ?></button>
        </div>
    </div>
</form>
